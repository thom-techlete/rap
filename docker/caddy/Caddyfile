{
	email {$CADDY_ACME_EMAIL:thom@techletes.ai}
}

{$DOMAIN:rap8.nl} {
	encode gzip zstd

	request_body {
		max_size 5MB
	}

	header {
		-Server
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ws: wss:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none';"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	}

	# Keep high-value authentication and account endpoints protected at the edge.
	rate_limit {
		zone login_limit {
			match {
				path /users/login/
				method POST
			}
			key {remote_host}
			window 5m
			events 20
		}

		zone registration_limit {
			match {
				path /users/register/
				method POST
			}
			key {remote_host}
			window 15m
			events 10
		}

		zone password_reset_limit {
			match {
				path /users/password-reset/ /users/reset/*
				method POST
			}
			key {remote_host}
			window 15m
			events 10
		}

		zone admin_login_limit {
			match {
				path /admin/login/
				method POST
			}
			key {remote_host}
			window 5m
			events 20
		}
	}

	@static path /static/*
	handle @static {
		root * /app
		header Cache-Control "public, max-age=2592000, immutable"
		file_server
	}

	@media path /media/*
	handle @media {
		root * /app
		header Cache-Control "private, max-age=604800"
		file_server
	}

	@health path /health /health/
	handle @health {
		reverse_proxy web:8000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			transport http {
				dial_timeout 5s
				read_timeout 30s
				write_timeout 30s
			}
		}
	}

	handle {
		reverse_proxy web:8000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			transport http {
				dial_timeout 5s
				read_timeout 120s
				write_timeout 120s
			}
		}
	}

	handle_errors {
		@400 expression `{http.error.status_code} == 400`
		@403 expression `{http.error.status_code} == 403`
		@404 expression `{http.error.status_code} == 404`
		@429 expression `{http.error.status_code} == 429`
		@502 expression `{http.error.status_code} == 502`
		@5xx expression `{http.error.status_code} >= 500 && {http.error.status_code} != 502`

		handle @400 {
			root * /etc/caddy/error-pages
			rewrite * /400.html
			file_server
		}
		handle @403 {
			root * /etc/caddy/error-pages
			rewrite * /403.html
			file_server
		}
		handle @404 {
			root * /etc/caddy/error-pages
			rewrite * /404.html
			file_server
		}
		handle @429 {
			respond "Too Many Requests" 429
		}
		handle @502 {
			root * /etc/caddy/error-pages
			rewrite * /502.html
			file_server
		}
		handle @5xx {
			root * /etc/caddy/error-pages
			rewrite * /500.html
			file_server
		}
	}

	log {
		output stdout
		format json
	}
}

www.{$DOMAIN:rap8.nl} {
	redir https://{$DOMAIN:rap8.nl}{uri} permanent
}
